# SITE_ADDRESS=:80 for IP-only access, or your domain (e.g. stockminds.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
