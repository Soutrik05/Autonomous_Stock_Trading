# Placeholder configuration template. Copy to .env and fill in real secrets (.env is git-ignored).
UPSTOX_ANALYTICS_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_GEMINI_THINKING_BUDGET=1024

# --- API / deployment (docker-compose.yml) ---
API_KEY=                       # optional; when set, /api/* (except /api/health) needs the X-API-Key header
API_CORS_ORIGINS=http://localhost:5173
S3_BACKUP_BUCKET=              # set by deploy; nightly portfolio.db backups are uploaded here
SITE_ADDRESS=:80               # your domain for automatic HTTPS, e.g. stockminds.example.com
