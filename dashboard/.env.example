# Base URL for the StockMinds backend REST API (see docs/api.md and docs/run_backend.md).
# Copy this file to .env.development (or .env.development.local) and adjust if your backend
# runs somewhere other than localhost:8000.
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" to force mock/fixture data instead of the real backend. Leave unset or "false"
# in every normal case -- the app never falls back to mock data silently when the backend
# fails; this flag is the only way mock data is ever shown.
VITE_USE_MOCK=false
